[MASTER]
ignore=build,dist
ignored-modules=pytest

[MESSAGES CONTROL]
disable=
    C0114,
    C0115,
    C0116,
    C0327,
    R0801,
    R0902,
    R0913,
    R0917,
    W0718,
    C0103,
    C0123

[FORMAT]
max-line-length=100

[DESIGN]
max-args=14
max-positional-arguments=14
max-attributes=20
max-public-methods=60
max-module-lines=1500
